# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Preencha com seus dados do painel Supabase > Project Settings > Database
SUPABASE_HOST=db.XXXXXXXXXX.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=SuaSenhaAqui

# ── JWT ──────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres — troque em produção!
JWT_SECRET=tagn-super-secret-key-change-in-production-must-be-32-chars
